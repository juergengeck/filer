<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleLocalizations</key>
	<array>
		<string>en</string>
		<string>de</string>
	</array>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleDisplayName</key>
	<string>OneFiler Extension</string>
	<key>CFBundleExecutable</key>
	<string>OneFilerExtension</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleIconFile</key>
	<string>ProviderIcon</string>
	<key>CFBundleName</key>
	<string>OneFilerExtension</string>
	<key>CFBundlePackageType</key>
	<string>XPC!</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>LSMinimumSystemVersion</key>
	<string>13.5</string>
	<key>CFBundleIcons</key>
	<dict>
		<key>CFBundlePrimaryIcon</key>
		<dict>
			<!-- The provider root icon is resolved from this extension's resources. -->
			<key>CFBundleIconFile</key>
			<string>ProviderIcon</string>
			<key>CFBundleSymbolName</key>
			<string>FilerSidebar</string>
		</dict>
	</dict>
	<key>NSExtension</key>
	<dict>
		<key>NSExtensionFileProviderDocumentGroup</key>
		<string>group.one.filer</string>
		<key>NSExtensionFileProviderSupportsEnumeration</key>
		<true/>
		<key>NSExtensionPointIdentifier</key>
		<string>com.apple.fileprovider-nonui</string>
		<key>NSExtensionPrincipalClass</key>
		<string>FileProviderExtension</string>
		<key>NSExtensionFileProviderActions</key>
		<array>
			<dict>
				<key>NSExtensionFileProviderActionIdentifier</key>
				<string>one.filer.action.device.mount</string>
				<key>NSExtensionFileProviderActionTitle</key>
				<string>Mount Device</string>
				<key>NSExtensionFileProviderActionActivationRule</key>
				<string>SUBQUERY(fileproviderItems, $item, $item.userInfo.mountState == 'available').@count == fileproviderItems.@count AND fileproviderItems.@count &gt; 0</string>
			</dict>
			<dict>
				<key>NSExtensionFileProviderActionIdentifier</key>
				<string>one.filer.action.device.unmount</string>
				<key>NSExtensionFileProviderActionTitle</key>
				<string>Unmount Device</string>
				<key>NSExtensionFileProviderActionActivationRule</key>
				<string>SUBQUERY(fileproviderItems, $item, $item.userInfo.mountState == 'mounted' OR $item.userInfo.mountState == 'mounting').@count == fileproviderItems.@count AND fileproviderItems.@count &gt; 0</string>
			</dict>
		</array>
		<key>NSFileProviderDecorations</key>
		<array>
			<dict>
				<key>Identifier</key>
				<string>one.filer.decoration.device.mounted</string>
				<key>Label</key>
				<string>Mounted</string>
				<key>Category</key>
				<string>Sharing</string>
			</dict>
			<dict>
				<key>Identifier</key>
				<string>one.filer.decoration.device.mounting</string>
				<key>Label</key>
				<string>Mounting…</string>
				<key>Category</key>
				<string>Sharing</string>
			</dict>
			<dict>
				<key>Identifier</key>
				<string>one.filer.decoration.device.available</string>
				<key>Label</key>
				<string>Available</string>
				<key>Category</key>
				<string>Sharing</string>
			</dict>
			<dict>
				<key>Identifier</key>
				<string>one.filer.decoration.device.offline</string>
				<key>Label</key>
				<string>Offline</string>
				<key>Category</key>
				<string>Sharing</string>
			</dict>
			<dict>
				<key>Identifier</key>
				<string>one.filer.decoration.device.denied</string>
				<key>Label</key>
				<string>Denied</string>
				<key>Category</key>
				<string>Sharing</string>
			</dict>
		</array>
	</dict>
</dict>
</plist>
