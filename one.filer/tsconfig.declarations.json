{
    "compilerOptions": {
        "noEmit": false,
        "alwaysStrict": true,
        "outDir": "lib",
        "baseUrl": ".",
        "isolatedModules": false,
        "moduleResolution": "node",
        "sourceMap": true,
        "emitDeclarationOnly": true,
        "declaration":true,
        "declarationMap": true,
        "downlevelIteration": true,
        "esModuleInterop": true,
        "lib": ["esnext", "dom"],
        "module": "es2015",
        "target": "esnext",
        "strict": true,
        "newLine": "LF",
        "allowJs": false,
        "checkJs": false,
        "noUnusedLocals": true,
        "removeComments": false,
        "preserveConstEnums": true,
        "forceConsistentCasingInFileNames": true,
        "noImplicitReturns": true,
        "paths": {
            "@refinio/one.core/*": ["../one/packages/one.core/lib/*"],
            "@refinio/one.models/*": ["../one/packages/one.models/lib/*"]
        }
    },
    "include": [
        "node-fhir-server-core.d.ts",
        "node-fhir.d.ts",
        "../one/packages/one.core/@OneObjectInterfaces.d.ts",
        "../one/packages/one.models/@OneObjectInterfaces.d.ts",
        "src/@OneObjectInterfaces.d.ts",
        "src"
    ],
    "exclude": [
        ".*.js",
        "builds",
        "doc"
    ]
}
