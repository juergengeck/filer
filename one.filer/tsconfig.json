{
    "compilerOptions": {
        "noEmit": true,
        "alwaysStrict": true,
        "outDir": "lib",
        "baseUrl": ".",
        "isolatedModules": false,
        "moduleResolution": "node",
        "sourceMap": false,
        "emitDeclarationOnly": false,
        "declaration": false,
        "declarationMap": false,
        "downlevelIteration": false,
        "esModuleInterop": true,
        "importHelpers": false,
        "importsNotUsedAsValues": "error",
        "lib": ["esnext", "dom"],
        "module": "esnext",
        "target": "esnext",
        "strict": true,
        "newLine": "LF",
        "allowJs": true,
        "checkJs": false,
        "noUnusedLocals": true,
        "removeComments": true,
        "preserveConstEnums": true,
        "forceConsistentCasingInFileNames": true,
        "noImplicitReturns": true,
        "types": ["@types/mocha", "node"],
        "paths": {
            "@refinio/one.core/*": ["../one/packages/one.core/lib/*"],
            "@refinio/one.models/*": ["../one/packages/one.models/lib/*"]
        }
    },
    "include": [
        "../one/packages/one.core/@OneObjectInterfaces.d.ts",
        "../one/packages/one.models/@OneObjectInterfaces.d.ts",
        "src/@OneObjectInterfaces.d.ts",
        "test/@OneObjectInterfaces.d.ts",
        "src/*.ts",
        "src/*/*.ts",
        "src/types/*.d.ts",
        "test/*/*.ts",
        "test/*.ts"
    ],
    "exclude": [
        "src/clients",
        ".*.js"
    ]
}
