{
  "name": "@refinio/one.projfs",
  "version": "1.0.0",
  "description": "Windows Projected File System (ProjFS) native addon for Node.js",
  "type": "module",
  "main": "index.js",
  "types": "index.d.ts",
  "exports": {
    ".": "./index.js",
    "./IFSProjFSProvider.js": {"types": "./index.d.ts", "import": "./IFSProjFSProvider.js"}
  },
  "scripts": {
    "install": "node-gyp rebuild",
    "build": "node-gyp rebuild",
    "rebuild": "node-gyp rebuild",
    "clean": "node-gyp clean",
    "test": "node --test test/*.test.js"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/refinio/one.projfs.git"
  },
  "keywords": [
    "projfs",
    "windows",
    "filesystem",
    "virtual-filesystem",
    "projected-file-system",
    "node-addon",
    "native-module"
  ],
  "author": "REFINIO GmbH",
  "license": "MIT",
  "dependencies": {
    "bindings": "^1.5.0",
    "node-addon-api": "^8.5.0"
  },
  "devDependencies": {
    "@refinio/filer.core": "link:../../one/packages/filer.core",
    "node-gyp": "^10.0.0"
  },
  "os": [
    "win32"
  ],
  "peerDependencies": {
    "@refinio/filer.core": "*"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
